<launch>
  <arg name="stage" default="all" doc="Pipeline stage to render: none|filter|cluster|all" />
  <arg name="pipeline_mode" default="classic" doc="classic|sam_rgbd" />
  <arg name="show_original_cloud" default="false" doc="Render original cloud instead of filtered cloud" />
  <arg name="sam_model_id" default="facebook/sam3.1-hiera-large" doc="SAM3 model id (Hugging Face)" />
  <arg name="sam_prompt" default="cube" doc="Text prompt for SAM3, e.g. cube or red cube" />
  <arg name="sam_device" default="auto" doc="auto|cpu|cuda" />

  <node pkg="franka_perception"
        type="listener_node.py"
        name="listener"
        output="screen"
        args="--stage $(arg stage)">
    <param name="show_original_cloud"  value="$(arg show_original_cloud)" />
    <param name="pipeline_mode"        value="$(arg pipeline_mode)" />
    <param name="use_rgbd"              value="true" />
    <param name="cloud_topic"           value="/zed2/zed_node/point_cloud/cloud_registered" />
    <param name="rgb_topic"             value="/zed2/zed_node/rgb/image_rect_color" />
    <param name="depth_topic"           value="/zed2/zed_node/depth/depth_registered" />
    <param name="camera_info_topic"     value="/zed2/zed_node/rgb/camera_info" />
    <param name="depth_scale"           value="0.0" />
    <param name="depth_trunc"           value="3.0" />
    <param name="rgbd_flip"             value="true" />
    <param name="cube_side_length"      value="0.045" />
    <param name="axis_size"             value="0.1" />
    <param name="voxel_size"            value="0.0005" />
    <param name="cluster_eps"           value="0.005" />
    <param name="cluster_min_points"    value="10" />
    <param name="base_plane_distance"   value="0.01" />
    <param name="below_plane_tolerance" value="0.002" />
    <param name="max_cluster_distance_from_plane_inliers" value="0.08" />
    <param name="max_cubes_per_cluster" value="2" />
    <param name="num_best_cubes"        value="100" />
    <param name="clearance"             value="0.015" />

    <!-- SAM-only params (used when pipeline_mode=sam_rgbd) -->
    <param name="sam_model_id"                value="$(arg sam_model_id)" />
    <param name="sam_device"                  value="$(arg sam_device)" />
    <param name="sam_prompt"                  value="$(arg sam_prompt)" />
    <param name="sam_score_threshold"         value="0.0" />
    <param name="sam_max_masks"               value="8" />
    <param name="sam_min_mask_pixels"         value="1200" />
    <param name="sam_min_depth_pixels"        value="600" />
    <param name="sam_mask_erosion_kernel"     value="3" />
    <param name="sam_mask_erosion_iterations" value="1" />
    <param name="sam_min_points_per_cluster"  value="120" />
    <param name="sam_max_mask_area_ratio"     value="0.35" />
    <param name="sam_plane_ransac_distance"   value="0.006" />
    <param name="sam_near_plane_distance"     value="0.006" />
    <param name="sam_max_near_plane_ratio"    value="0.85" />
    <param name="sam_min_mask_plane_height"   value="0.012" />
    <param name="sam_max_cluster_extent_multiplier" value="2.8" />
    <param name="sam_max_cluster_volume_multiplier" value="7.0" />
    <param name="sam_show_windows"            value="true" />
    <param name="sam_window_wait_ms"          value="1" />
  </node>
</launch>
